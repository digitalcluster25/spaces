{
  "name": "spaces",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:harness": "npm --prefix harness test",
    "test:integration": "node tests/project-members.integration.mjs && node tests/superadmin-mfa.integration.mjs && node tests/billing.integration.mjs",
    "test:billing": "node --test infrastructure/billing/server.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:harness && npm run test:billing && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.54.0",
    "@vitejs/plugin-react": "^6.0.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1"
  }
}
